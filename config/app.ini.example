; =============================================================================
;  config/app.ini.example  —  本地配置模板
;
;  用法：复制为 config/app.ini 后填入自己的值。
;        config/app.ini 已被 .gitignore 忽略，不会进仓库。
;
;      cp config/app.ini.example config/app.ini
;
;  [说明书] 2.2 合理考虑数据安全问题 —— 凭据不入库、不提交
; =============================================================================

[server]
; [本组自定] 与 t_sys_config.server_port 保持一致
host = 127.0.0.1
port = 9527
; [本组自定] pthread 线程池大小。每条连接占用一个线程直到断开，
; 因此这个值就是最大并发连接数。测多个电桩模拟器时按需调大。
pool_size = 8

[map]
; [说明书] 1.4 调用腾讯地图 Web API 完成地址解析与路线规划
;
; 申请步骤（L4 负责，每人各申请一个，不要共用）：
;   1. 访问 https://lbs.qq.com/ 用微信或 QQ 注册开发者账号并完成实名
;   2. 控制台 → 应用管理 → 我的应用 → 创建应用
;   3. 添加 Key，类型勾选「WebServiceAPI」与「JavaScript API」
;   4. 授权 IP 白名单：本机调试填 0.0.0.0/0 或留空；答辩演示机另加一条
;   5. 把生成的 Key 填到下面 key= 后面
;
; 注意：免费额度按 Key 计算（地理编码约 1 万次/日）。五个人共用一个 Key，
;       联调时很容易在同一天把额度跑满，答辩当天就调不通了。所以各申请各的。
key =

; [本组自定] 模拟 GPS 的默认定位点（深圳市民中心），与种子数据坐标一致
default_lng = 114.0650
default_lat = 22.5470

[dataviz]
; [本组自定] L5 导出 JSON 快照的目录与周期（秒）
snapshot_dir = dataviz/data
snapshot_interval = 10
