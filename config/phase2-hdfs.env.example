#  第二阶段 ODS 数据源指向 HDFS。
#  实际文件 config/phase2-hdfs.env 由 scripts/ods-to-hdfs.sh 生成（config/* 不入库）。
#
#  用法：set -a; . config/phase2-hdfs.env; set +a
#  改回本地目录只需 unset ECP_ODS_ROOT —— 代码只认路径不认介质（CLAUDE.md 5.2 第 10 条）。
export ECP_ODS_ROOT=hdfs://localhost:9000/ecp/ods
#  分析侧的 HDFS 身份。必须是非超级用户，否则 ODS 的 444 权限会被绕过，
#  详见 bigdata/spark/spark_session.py 的 _pin_hdfs_identity。
export ECP_HDFS_USER=ecp_analyst
export HADOOP_HOME=$HOME/opt/hadoop
