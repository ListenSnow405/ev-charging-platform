# ---- 本地密钥与配置（禁止提交）----------------------------------------------
# 腾讯位置服务 Key 等凭据只存本地，仓库里只保留 .example 模板
config/*
!config/*.example
!config/.gitkeep
*.key
.env

# ---- Qt / C++ 构建产物 -------------------------------------------------------
build/
build-*/
*.o
*.so
*.a
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
Makefile
Makefile.*
*.pro.user
*.pro.user.*
.qmake.stash

# ---- 运行期数据（数据库由 db-schema.sql 生成，不入库）--------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
logs/
*.log

# ---- Python（ml/ 与 dataviz/）------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.pkl
*.joblib

# ---- 编辑器与系统 ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# ---- 大屏运行期快照（由 ml/export_snapshot.py 生成）----
dataviz/data/*.json

# ---- 历史数据生成器产物（由 ml/gen_history.py 生成）----
ml/data/*.csv
