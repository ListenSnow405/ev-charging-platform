qrc_*.cpp
ui_*.h
Makefile
Makefile.*
*.pro.user
*.pro.user.*
.qmake.stash

# ---- 运行期数据（数据库由 db-schema.sql 生成，不入库）--------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
logs/
*.log

